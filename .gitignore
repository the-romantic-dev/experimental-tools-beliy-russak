# Данные и результаты: тяжёлые и у каждого свои.
data/
artifacts/
runs/
preds/
submissions/

# Архивы. Тут лежит «вайбик + кодик.zip» на 23 МБ — в git ему делать нечего.
*.zip

# Личные компоненты воркспейса; образец лежит в docs/aic_plugins.example.py
aic_plugins.py

# Конфиги и планы: в репозитории только примеры и smoke. Рабочие гипотезы
# остаются локальными у каждого — они и есть содержание исследования.
configs/*
!configs/_base.yaml
!configs/smoke.yaml
!configs/baseline.yaml
!configs/fast_cache_384.yaml
!configs/segformer_mit_b2.yaml
!configs/upernet_convnext_640.yaml

plans/*
!plans/example.yaml

# Разборы результатов — тоже локальные
docs/experiments_*.md

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/
.venv/
venv/

